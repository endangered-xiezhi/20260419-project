# 智谱开放平台 https://open.bigmodel.cn/ — 创建 API Key 后填入（勿将真实密钥提交到 Git）
ZHIPU_API_KEY=

# 可选，默认 glm-4-flash
# ZHIPU_MODEL=glm-4-flash

# 腾讯元器智能体（只配置在服务端）
YUANQI_API_KEY=
YUANQI_BOT_ID=

# 飞书自建应用（只配置在 Render/服务端，严禁放进 VITE_ 开头的前端变量）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 二选一：有真正的多维表格 app_token 时优先填写 BASE_APP_TOKEN；
# 只有 /wiki/ 链接时填写链接中 /wiki/ 后面的 token。
FEISHU_BASE_APP_TOKEN=
FEISHU_WIKI_TOKEN=

# 可选。代码默认按“会议表”“人员表”名称自动查找；
# 如果表被改名，填写对应的 tbl... ID。
FEISHU_MEETING_TABLE_ID=
FEISHU_PERSON_TABLE_ID=
FEISHU_SHAREHOLDER_TABLE_ID=
FEISHU_PROPOSAL_TABLE_ID=
FEISHU_VOTE_TABLE_ID=
FEISHU_DOCUMENT_TABLE_ID=
FEISHU_TEMPLATE_TABLE_ID=
FEISHU_DOCUMENT_JOB_TABLE_ID=

# 飞书多维表格自动化调用 Render 时使用。请自行生成一串随机字符，
# Render 和飞书自动化请求体中的 secret 必须完全一致。
FEISHU_AUTOMATION_SECRET=

# 后续启用飞书文件夹永久归档时再填写。
FEISHU_ARCHIVE_FOLDER_TOKEN=

# 飞书租户域名，只填主机名，用于生成可点击的归档文件夹地址。
# 示例：example.feishu.cn
FEISHU_TENANT_DOMAIN=

# 飞书网页 OAuth。回调地址必须与飞书开放平台配置完全一致。
FEISHU_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/feishu/callback
FEISHU_OAUTH_SUCCESS_REDIRECT=http://localhost:3001/
FEISHU_OAUTH_SCOPES=offline_access auth:user.id:read

# 请分别生成至少 32 字节的随机值，只保存在服务端。
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# 生产环境建议设为 true，并把前端正式域名加入允许列表。
REQUIRE_FEISHU_LOGIN=false
ALLOWED_ORIGINS=http://localhost:3001
